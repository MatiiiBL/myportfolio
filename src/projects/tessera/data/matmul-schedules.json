  "defaults": { "tile_m": 4, "tile_n": 16, "order": "nm", "pack_b": true, "parallel": true },
  "unscheduled": "@prim_func\ndef matmul(A: float32[64, 256], W: float32[256, 128], b: float32[128], relu: float32[64, 128]):\n    matmul = alloc_buffer(float32[64, 128])\n    for m in range(64):\n        for n in range(128):\n            for k in range(256):\n                with block('matmul'):\n                    v_m = spatial(64, m)\n                    v_n = spatial(128, n)\n                    v_k = reduce(256, k)\n                    with init():\n                        matmul[v_m, v_n] = 0.0\n                    matmul[v_m, v_n] = matmul[v_m, v_n] + A[v_m, v_k] * W[v_k, v_n]\n    for i0 in range(64):\n        for i1 in range(128):\n            with block('relu'):\n                v_i0 = spatial(64, i0)\n                v_i1 = spatial(128, i1)\n                relu[v_i0, v_i1] = max(matmul[v_i0, v_i1] + b[v_i1], 0.0)",
  "default": {
    "trace": [
      "split(m, [None, 4]) -> [m_0, m_1]",
      "split(n, [None, 16]) -> [n_0, n_1]",
      "reorder([n_0, m_0, k, m_1, n_1])",
      "cache_write('matmul', 0, 'local') -> 'matmul_local'",
      "reverse_compute_at('matmul_local', m_0)",
      "decompose_reduction('matmul', k) -> 'matmul_init'",
      "reverse_compute_inline('relu')",
      "unroll(m_1)",
      "vectorize(n_1)",
      "vectorize(ax1)",
      "cache_read('matmul', 1, 'local') -> 'W_local'",
      "compute_at('W_local', n_0)",
      "parallel(n_0)"
    ],
    "ir": "@prim_func\ndef matmul(A: float32[64, 256], W: float32[256, 128], b: float32[128], relu: float32[64, 128]):\n    matmul_local = alloc_buffer(float32[64, 128], 'local')\n    W_local = alloc_buffer(float32[256, 128], 'local')\n    for n_0 in parallel(8):\n        for ax0_1 in range(256):\n            for ax1_1 in range(16):\n                with block('W_local'):\n                    v0_1 = spatial(256, ax0_1)\n                    v1_1 = spatial(128, n_0 * 16 + ax1_1)\n                    W_local[v0_1, v1_1] = W[v0_1, v1_1]\n        for m_0 in range(16):\n            for m_1_init in range(4):\n                for n_1_init in range(16):\n                    with block('matmul_init'):\n                        v_m_1 = spatial(64, m_0 * 4 + m_1_init)\n                        v_n_1 = spatial(128, n_0 * 16 + n_1_init)\n                        matmul_local[v_m_1, v_n_1] = 0.0\n            for k in range(256):\n                for m_1 in unrolled(4):\n                    for n_1 in vectorized(16):\n                        with block('matmul'):\n                            v_m = spatial(64, m_0 * 4 + m_1)\n                            v_n = spatial(128, n_0 * 16 + n_1)\n                            v_k = reduce(256, k)\n                            matmul_local[v_m, v_n] = matmul_local[v_m, v_n] + A[v_m, v_k] * W_local[v_k, v_n]\n            for ax0 in range(4):\n                for ax1 in vectorized(16):\n                    with block('matmul_local'):\n                        v0 = spatial(64, m_0 * 4 + ax0)\n                        v1 = spatial(128, n_0 * 16 + ax1)\n                        relu[v0, v1] = max(matmul_local[v0, v1] + b[v1], 0.0)"
  },
